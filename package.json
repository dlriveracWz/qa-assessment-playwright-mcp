{
  "name": "qa-assessment-playwright-mcp",
  "version": "1.0.0",
  "description": "Standardized assessment repository for QA & SDET engineers evaluating Playwright and Model Context Protocol (MCP)",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=smoke",
    "test:regression": "playwright test --project=regression",
    "test:api": "playwright test --project=regression tests/api",
    "test:debug": "playwright test --ui",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "report": "playwright show-report",
    "triage": "ts-node scripts/ai-triage.ts",
    "setup": "npx playwright install"
  },
  "keywords": [
    "playwright",
    "mcp",
    "qa",
    "sdet",
    "assessment",
    "agentic-testing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.17.0",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
